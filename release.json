{
  "id": "theburg",
  "name": "The Burg",
  "description": "A life sim set in Waitsburg, WA: work, bills, Highway 12 and small-town life, one week at a time.",
  "site": ".",
  "app": ".",
  "exclude": [],
  "sw": "sw.js",
  "version": [
    {
      "file": "js/state.js",
      "pattern": "const APP_VERSION = '([^']*)'"
    }
  ],
  "android": {
    "enabled": true,
    "appId": "com.krazow.theburg"
  },
  "windows": {
    "enabled": true,
    "port": 47920
  },
  "ios": {
    "enabled": false
  },
  "macos": {
    "enabled": false
  },
  "extras": {
    "enabled": false
  },
  "test_groups": [
    "test:group1",
    "test:group2",
    "test:group3",
    "test:group4"
  ],
  "test_timeout": 25
}
